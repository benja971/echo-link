  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Copie explicite.",
      "html": "<button class=\"ds-primary\">Copy link</button>",
      "css": ".ds-primary{font-family:var(--font-sans,\"Geist Variable\", ui-sans-serif, system-ui, sans-serif);font-size:14px;line-height:20px;min-height:44px;padding:8px 16px;font-weight:500;border:0;border-radius:6px;background:var(--color-accent,#1f4f91);color:var(--color-on-accent, #ffffff)}.ds-primary:focus-visible{outline:2px solid var(--color-accent,#1f4f91);outline-offset:3px}.ds-primary{transition:background-color 150ms,border-color 150ms,color 150ms}@media(hover:hover){.ds-primary:not(:disabled):hover{background:var(--color-accent-hover, color-mix(in srgb, var(--color-accent, #1f4f91) 76%, #000000));color:var(--color-on-accent, #ffffff)}}.ds-primary:not(:disabled):active{background:var(--color-accent-active, color-mix(in srgb, var(--color-accent, #1f4f91) 64%, #000000));color:var(--color-on-accent, #ffffff)}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Action neutre.",
      "html": "<button class=\"ds-secondary\">Download</button>",
      "css": ".ds-secondary{font-family:var(--font-sans,\"Geist Variable\", ui-sans-serif, system-ui, sans-serif);font-size:14px;line-height:20px;min-height:44px;padding:8px 16px;border:1px solid var(--color-surface1, #d3d9cf);border-radius:6px;background:var(--color-surface0, #e9ede7);color:var(--color-subtext1, #4a574a);transition:color 150ms,background-color 150ms}.ds-secondary:focus-visible{outline:2px solid var(--color-accent,#1f4f91);outline-offset:3px}.ds-secondary{transition:background-color 150ms,border-color 150ms,color 150ms}@media(hover:hover){.ds-secondary:not(:disabled):hover{background:var(--color-surface1, #d3d9cf);border-color:var(--color-overlay1, #4a574a);color:var(--color-text, #202920)}}.ds-secondary:not(:disabled):active{background:var(--color-surface2, #b8c2b4);border-color:var(--color-overlay1, #4a574a);color:var(--color-text, #202920)}"
    },
    {
      "name": "Share URL",
      "kind": "input",
      "refersTo": "input-link",
      "description": "URL sélectionnable.",
      "html": "<input class=\"ds-url\" aria-label=\"Share link\" readonly value=\"https://echo.example/v/sample\">",
      "css": ".ds-url{font-family:var(--font-mono,\"JetBrains Mono\", ui-monospace, \"SF Mono\", monospace);font-size:16px;line-height:24px;min-height:44px;max-width:100%;padding:8px 12px;border:1px solid var(--color-subtext1, #4a574a);border-radius:6px;background:var(--color-mantle, #ffffff);color:var(--color-text, #202920)}.ds-url:focus-visible{outline:2px solid var(--color-accent,#1f4f91);outline-offset:1px}"
    },
    {
      "name": "Selected format",
      "kind": "chip",
      "refersTo": "format-chip-selected",
      "description": "Choix de format explicite.",
      "html": "<button class=\"ds-chip\" aria-pressed=\"true\">Markdown</button>",
      "css": ".ds-chip{font-family:var(--font-sans,\"Geist Variable\", ui-sans-serif, system-ui, sans-serif);font-size:14px;line-height:20px;min-height:44px;padding:0 12px;border:1px solid var(--color-accent,#1f4f91);border-radius:6px;background:var(--color-surface0, #e9ede7);color:var(--color-accent,#1f4f91)}.ds-chip:focus-visible{outline:2px solid var(--color-accent,#1f4f91);outline-offset:3px}.ds-chip{transition:background-color 150ms,border-color 150ms,color 150ms}@media(hover:hover){.ds-chip:not(:disabled):hover{background:var(--color-surface1, #d3d9cf);border-color:var(--color-overlay1, #4a574a);color:var(--color-text, #202920)}}.ds-chip:not(:disabled):active{background:var(--color-surface2, #b8c2b4);border-color:var(--color-overlay1, #4a574a);color:var(--color-text, #202920)}@media(hover:hover){.ds-chip[aria-pressed=\"true\"]:hover{border-color:var(--color-accent, #1f4f91);color:var(--color-accent, #1f4f91)}}"
