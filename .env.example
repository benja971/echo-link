# Server
PORT=3000

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=echo-link
DATABASE_SSL=0
DATABASE_LOGGING=0

# S3/MinIO Configuration
S3_ENDPOINT=localhost
S3_PORT=9000
S3_USE_SSL=false
S3_REGION=us-east-1
S3_BUCKET_NAME=echo-link
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Public URLs
PUBLIC_BASE_URL=https://echo-link.mondomaine.fr
# Files are served through the app at /files/*. Keep this equal to PUBLIC_BASE_URL
# unless a reverse proxy intentionally serves that path on another hostname.
CDN_PUBLIC_BASE_URL=https://echo-link.mondomaine.fr

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
EMAIL_FROM=Echo Link <onboarding@resend.dev>

# Magic Link
SESSION_SECRET=generate-at-least-32-characters-with-openssl-rand-hex-32
MAGIC_LINK_EXPIRATION_MINUTES=15

# Anonymous uploads
ANONYMOUS_IP_SALT=generate-at-least-16-characters-with-openssl-rand-hex-16
ANON_ENABLED=true
ANON_MAX_SIZE_MB=50
ANON_MAX_PER_IP_PER_DAY=3
ANON_EXPIRATION_HOURS=24

# Authenticated-account limits
FILE_EXPIRATION_DAYS=10
MAX_SIZE_MB=100
MAX_PER_USER=25
MAX_SIZE_MB_PER_USER=500

# ============================================
# Discord Bot Configuration
# ============================================

# Discord API credentials (from Discord Developer Portal)
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_CLIENT_ID=your-discord-application-id

# Guild ID for slash command registration:
# - Set a specific guild ID for DEVELOPMENT (commands appear instantly)
# - Leave EMPTY for PRODUCTION (global commands, up to 1h to propagate)
DISCORD_GUILD_ID=

# Echo-Link API integration (bot <-> API communication)
# Token for bot to authenticate with Echo-Link API (generate a secure random string)
ECHOLINK_BOT_TOKEN=your-secure-bot-token-here

# Base URL for the bot to call Echo-Link API
ECHOLINK_BASE_URL=http://localhost:3000
